{
  "name": "vitekube",
  "version": "0.0.1",
  "description": "Vitest on real Kubernetes clusters. Write integration tests that feel like unit tests.",
  "keywords": [
    "e2e",
    "helm",
    "integration-testing",
    "k3d",
    "k8s",
    "kubernetes",
    "testing",
    "vitest"
  ],
  "homepage": "https://vitekube.com",
  "bugs": "https://github.com/vitekube/vitekube/issues",
  "license": "MIT",
  "author": "Dragan Bajcic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitekube/vitekube.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./core": "./dist/core/index.mjs",
    "./node": "./dist/node.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config --no-agent && vp pack",
    "e2e": "vp test run --config e2e/vitest.config.ts",
    "e2e:all": "sh scripts/e2e-all.sh",
    "e2e:tarball": "sh scripts/e2e-tarball.sh"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
